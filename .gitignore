# ============================================================
# React Weather Forecasting App
# .gitignore
#
# Objective:
# Prevent generated, local, sensitive, and machine-specific
# files from being committed to Git.
#
# Author: mghazel
# Date: 31-Aug-2026
# Version: 6.0
# ============================================================


# ============================================================
# 1. NODE / NPM DEPENDENCIES
# ============================================================

node_modules/


# ============================================================
# 2. VITE / PRODUCTION BUILD OUTPUT
# ============================================================

dist/
dist-ssr/


# ============================================================
# 3. LOCAL ENVIRONMENT CONFIGURATION
#
# Open-Meteo does NOT require an API key for the free
# non-commercial API used by this project.
#
# These rules remain as general security protection in case
# environment-specific credentials/configuration are added
# later.
# ============================================================

.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local


# ============================================================
# 4. LOG FILES
# ============================================================

logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# ============================================================
# 5. TEST / COVERAGE OUTPUT
# ============================================================

coverage/


# ============================================================
# 6. EDITOR / IDE FILES
# ============================================================

.vscode/*
!.vscode/extensions.json

.idea/

*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?


# ============================================================
# 7. OPERATING SYSTEM FILES
# ============================================================

.DS_Store
Thumbs.db
